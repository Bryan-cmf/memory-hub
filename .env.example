# MemoryHub Environment Variables
# Copy to ~/.memory-hub/.env and customize

# ── Core ──────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
# auto = mps on macOS, cpu elsewhere
MEMORY_COLLECTION=openclaw_mem
MEMORYHUB_PORT=3872
DAEMON_HOOK_URL=http://localhost:3872/hook

# ── Qdrant (primary vector DB) ───────────
QDRANT_URL=http://localhost:6333

# ── Optional backends ─────────────────────
REDIS_URL=redis://localhost:6379
POSTGRESQL_URL=postgresql://postgres:postgres@localhost:5433/memoryhub
ELASTICSEARCH_URL=http://localhost:9200
MONGODB_URL=mongodb://localhost:27017
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── PostgreSQL (fine-grained) ─────────────
# Used by sync_engine.py if POSTGRESQL_URL is not set
PG_HOST=localhost
PG_PORT=5433
PG_DBNAME=postgres
PG_USER=postgres
PG_PASSWORD=

# ── Search tuning ─────────────────────────
SIMILARITY_THRESHOLD=0.6
